# ==========================================
# 1. 核心隐私与敏感数据（死都不能推！）
# ==========================================
.env
.env.*
*.pem
*.key
credentials.json

# ==========================================
# 2. Python 虚拟环境与依赖管理（由 uv / pip 自动生成）
# ==========================================
.venv/
venv/
ENV/
env/
# uv 的缓存和工具链
.uv/
.python-version

# ==========================================
# 3. 操作系统和编辑器的垃圾文件
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# VS Code 局部设置
.vscode/
# PyCharm / Idea 设置
.idea/

# ==========================================
# 4. Python 运行时自动生成的缓存（推上去会导致代码冲突）
# ==========================================
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# ==========================================
# 5. 业务产生的临时测试数据（根据你的标书/日志系统定制）
# ==========================================
*.log
local_attachment_dir/
logs/
tmp/

# ==========================================
# 6. 知识库本地数据库与索引产物（部署环境重建，不进仓库）
# ==========================================
kb/data/mongodb/
kb/data/processed/index/milvus.db
kb/data/processed/index/faiss.db/
kb/data/processed/index/faiss_qwen.db/
