# =========================
# 通用 LLM API 配置
# =========================
LLM_API_KEY=
LLM_BASE_URL=
DEFAULT_CHAT_MODEL=

# 不同链路可单独指定模型；不填时默认走 DEFAULT_CHAT_MODEL
REWRITE_MODEL=
ARBITRATION_MODEL=
FUNCTION_CALL_MODEL=
NLG_MODEL=
CORRELATION_MODEL=
BOT_MODEL=

# 闲聊 Bot API（如果和 LLM_BASE_URL 一样，可不填）
BOT_BASE_URL=
BOT_API_KEY=

# 高德地图 API Key（MCP 工具会用到）
AMAP_MAPS_API_KEY=

# =========================
# 微服务地址
# =========================
REJECT_URL=http://127.0.0.1:8007/reject-server/v1
INTENT_URL=http://127.0.0.1:8008/intent-server/v1
NLU_URL=http://127.0.0.1:8009/chatnlu-server/v1
RAG_URL=http://127.0.0.1:8010/rag-server/v1
ENTRY_URL=http://127.0.0.1:8080/request_nlu
FLASK_SERVER_PORT=8080
RAG_TIMEOUT=8.0
RAG_LLM_API_KEY=
RAG_LLM_BASE_URL=
RAG_LLM_MODEL=

# =========================
# 兼容历史变量（可选）
# =========================
API_KEY=
BASE_URL=
BOT_URL=
DOUBAO_API_KEY=
DOUBAO_BASE_URL=
DOUBAO_MODEL_NAME=
